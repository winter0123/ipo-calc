# cp terraform.tfvars.example terraform.tfvars 후 값 채우기 (terraform.tfvars는 git 제외)
tenancy_ocid        = "ocid1.tenancy.oc1..xxxx"
user_ocid           = "ocid1.user.oc1..xxxx"
fingerprint         = "aa:bb:cc:..."
private_key_path    = "~/.oci/oci_api_key.pem"
region              = "ap-seoul-1"
ssh_public_key_path = "~/.ssh/oracle_vm.pub"
# 내 공인 IP/32 로 좁히는 것을 권장 (예: curl -s ifconfig.me)
ssh_allowed_cidr    = "0.0.0.0/0"
