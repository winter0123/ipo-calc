{
	# 터널(Tailscale Funnel·Cloudflare Tunnel) 뒤에서만 TRUSTED_PROXIES=private_ranges 로 켠다.
	# 기본값(루프백)은 어떤 외부 요청도 신뢰하지 않아 직접 노출 때와 동작이 같다.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers {$CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

{$SITE_ADDRESS} {
	# 공모주 목록 등 JSON·JS 응답 압축(전송량이 서버 처리보다 병목 — 1,500건 목록 665KB 측정)
	encode zstd gzip

	# 정적 화면 응답에도 보안 헤더(API 응답은 Spring Security가 붙인다).
	# 화면은 외부 자원을 쓰지 않으므로 같은 출처만 허용. 인라인 style 속성(React·차트)만 예외.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# 서비스 워커·매니페스트는 캐시하지 않아 새 배포가 바로 반영되게 한다(웹 푸시)
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	handle_path /api/* {
		# 위조 가능한 헤더 대신 Caddy가 판정한 실제 방문자 IP를 backend(요청 제한)로 넘긴다
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		root * /srv/ui
		try_files {path} /index.html
		file_server
	}
}
