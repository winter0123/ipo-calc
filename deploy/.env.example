# cp .env.example .env 후 값 채우기 (.env는 git 제외, 운영 VM에서는 chmod 600)
DB_PASSWORD=change-me
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -base64 32
APP_REMEMBER_ME_KEY=
# 운영: 도메인(예: 이름.duckdns.org, 자동 HTTPS). 로컬 테스트: :80
SITE_ADDRESS=:80
# 로컬 http 테스트는 false, 운영(HTTPS)은 true
SESSION_COOKIE_SECURE=false
# 로컬에서 포트 충돌 시 변경
HTTP_PORT=18080
HTTPS_PORT=18443
