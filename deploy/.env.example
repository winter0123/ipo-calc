# cp .env.example .env 후 값 채우기 (.env는 git 제외, 운영 VM에서는 chmod 600)
DB_PASSWORD=change-me
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 운영: 도메인(예: 이름.duckdns.org, 자동 HTTPS). 로컬 테스트: :80
SITE_ADDRESS=:80
# 운영(HTTPS)은 true. 로컬 http 테스트일 때만 false로 바꾼다
SESSION_COOKIE_SECURE=true
# 로컬에서 포트 충돌 시 변경
HTTP_PORT=18080
HTTPS_PORT=18443
# 증권사 연동(앱키·시크릿 암호화). 증권사 연동을 쓰면 필수: openssl rand -base64 32
APP_ENCRYPTION_BROKER_KEY=
# 금융감독원 OpenDART 인증키(공모주 일정·상세 동기화). https://opendart.fss.or.kr 에서 발급
OPENDART_API_KEY=
# 공공데이터포털 한국천문연구원 특일 정보 서비스키(휴장일 동기화)
DATA_GO_KR_SERVICE_KEY=

# --- 외부 접속 터널(선택, docs/home-server.md). 둘 중 하나만 쓴다 ---
# [Tailscale Funnel] docker-compose.tailscale.yml: tailscale 관리 콘솔에서 발급한 인증키(재사용 불가·만료 짧게)
TS_AUTHKEY=
# 기기 이름. 주소는 https://<이름>.<tailnet>.ts.net
TS_HOSTNAME=vibe
# [Cloudflare Tunnel] docker-compose.cloudflared.yml: 대시보드 Zero Trust > Tunnels 의 토큰
TUNNEL_TOKEN=

# 웹 푸시 알림(브라우저 알림). VAPID 키 쌍 생성: npx web-push generate-vapid-keys
# 세 값이 모두 있어야 켜지고, 비어 있으면 알림 설정 화면이 "설정 안 됨"을 안내한다. 개인키는 비밀로 취급
APP_WEBPUSH_PUBLIC_KEY=
APP_WEBPUSH_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 주소(mailto:이메일)
APP_WEBPUSH_SUBJECT=
